package life

// Step advances a Game of Life board one generation.
func Step(b [][]bool) [][]bool {
	h, w := len(b), len(b[0])
	out := make([][]bool, h)
	for y := range out {
		out[y] = make([]bool, w)
		for x := range out[y] {
			n := 0
			for dy := -1; dy <= 1; dy++ {
				for dx := -1; dx <= 1; dx++ {
					if (dx != 0 || dy != 0) && b[(y+dy+h)%h][(x+dx+w)%w] {
						n++
					}
				}
			}
			out[y][x] = n == 3 || n == 2 && b[y][x]
		}
	}
	return out
}
