      export IPFS_PATH=/path/to/ipfsrepo


</code></pre></div><h2 id="ipfs-key-sign"><a href="#ipfs-key-sign" class="header-anchor">#</a> ipfs key sign</h2> <div class="language- extra-class"><pre class="language-text"><code>WARNING:   EXPERIMENTAL, command may change in future releases

USAGE
