SYNOPSIS
  ipfs p2p close [--all | -a] [--protocol=&#x3C;protocol> | -p]
                 [--listen-address=&#x3C;listen-address> | -l]
                 [--target-address=&#x3C;target-address> | -t]

OPTIONS

